{
  "name": "@ax2zicode/dsh-dev-toolbox",
  "version": "0.1.0",
  "description": "DSH plugin bundle: one command installs four deterministic, offline plugins (46 tools) covering JSON/YAML/CSV/diff/regex/encoding chores plus JVM, Python and Windows production diagnostics. Ships no code of its own — it inserts the four bundle rows, and the four plugins stay independently versioned.",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "plugin-bundle",
    "bundle",
    "toolbox",
    "one-command",
    "deterministic",
    "offline",
    "local-first",
    "no-network",
    "read-only",
    "developer-tools",
    "agent-tools",
    "json",
    "yaml",
    "csv",
    "diff",
    "regex",
    "encoding",
    "hash",
    "jvm",
    "thread-dump",
    "gc-log",
    "python",
    "traceback",
    "pytest",
    "django",
    "windows",
    "netstat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax2/dsh-dev-toolbox.git"
  },
  "homepage": "https://github.com/ax2/dsh-dev-toolbox#readme",
  "bugs": {
    "url": "https://github.com/ax2/dsh-dev-toolbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-deterministic-tools": "^0.1.3",
    "dsh-jvm-doctor": "^0.1.2",
    "dsh-py-doctor": "^0.1.2",
    "dsh-win-native": "^0.1.2"
  }
}
